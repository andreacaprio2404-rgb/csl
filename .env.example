# Copy these into Netlify (Site configuration > Environment variables), never commit real values.

# Fathom, from the webhook's signing secret shown when you create it (starts with whsec_)
FATHOM_WEBHOOK_SECRET=whsec_replace_me

# Only needed if you want this project's setup script to create the Fathom webhook via API
# instead of creating it by hand in the Fathom dashboard.
FATHOM_API_KEY=replace_me

# Anthropic, used for the scoring and notes generation pass
ANTHROPIC_API_KEY=replace_me
# Optional override, defaults to claude-sonnet-5 in code
CLAUDE_MODEL=claude-sonnet-5

# Notion, an internal integration token (Settings > Connections > Develop or manage integrations)
# The integration must be explicitly shared with both the RZ Leads DB and the Imported Call Notes DB.
NOTION_API_KEY=secret_replace_me

# GHL, a Private Integration Token for the SLAY location, scoped to:
# contacts.readonly, contacts.write, opportunities.readonly, opportunities.write, locations/customFields.readonly
GHL_API_KEY=replace_me
